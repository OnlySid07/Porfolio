---
interface Proyecto {
  title: string;
  description: string;
  link: string;
  image: string;
}

const PROYECTS: Proyecto[] = [
  {
    title: "POS Tienda",
    description:
      "Punto de venta de escritorio para Windows, offline-first: ventas, caja, inventario, clientes, reportes y facturación electrónica.",
    link: "https://github.com/OnlySid07/pos-releases",
    image: "/proyectos/pos-tienda.png",
  },
  {
    title: "BCP · Metas Comerciales",
    description:
      "Plataforma de control de objetivos comerciales: puntos, derivaciones y renta por colaborador, con metas individuales y estadísticas en vivo.",
    link: "https://bcp-pds.vercel.app/",
    image: "/proyectos/bcp-pds.png",
  },
  {
    title: "SIVAC · Vacaciones y Controversias",
    description:
      "Sistema de gestión de solicitudes de vacaciones y aprobaciones para colaboradores, con paneles diferenciados por rol.",
    link: "https://vacations-controversia.vercel.app/",
    image: "/proyectos/vacaciones-controversia.png",
  },
  {
    title: "Briggite D'talles",
    description:
      "E-commerce de arreglos florales con catálogo, carrito de compras, Supabase y Cloudinary.",
    link: "https://briggite-dtalles.vercel.app/",
    image: "/Proyect1.webp",
  },
  {
    title: "Impresor de Tickets",
    description:
      "Editor web para crear dedicatorias y tickets con vista previa en vivo y soporte para impresoras térmicas de 80 mm y 58 mm.",
    link: "https://tickets-kappa-nine.vercel.app/",
    image: "/proyectos/impresor-tickets.png",
  },
  {
    title: "BCP Trivia Challenge",
    description:
      "Desafío de trivia interactivo para colaboradores de BCP, con modos individual y multijugador.",
    link: "https://bcp-trivia.vercel.app/",
    image: "/proyectos/bcp-trivia.png",
  },
  {
    title: "App Financiera",
    description:
      "Aplicación PWA para gestionar finanzas personales, con funcionamiento y sincronización offline.",
    link: "https://app-financiera-ten.vercel.app/",
    image: "/proyectos/app-financiera.png",
  },
  {
    title: "Productos Perecibles · Promart",
    description:
      "Sistema de control de productos perecibles: consulta por SKU, recepciones y escaneo de LPN.",
    link: "https://perecibles-promart.vercel.app/",
    image: "/Proyect2.webp",
  },
  {
    title: "Jana Tattoo",
    description:
      "Sitio web para estudio de tatuajes minimalistas, con galería de trabajos y reserva de citas.",
    link: "https://jana-tattoo.vercel.app/",
    image: "/proyectos/jana-tattoo.png",
  },
  {
    title: "Gestor de Tickets",
    description:
      "Sistema de gestión de tickets para atención al cliente, con modos de trabajo individual y en línea.",
    link: "https://ticket-app-beige.vercel.app/",
    image: "/proyectos/gestor-tickets.png",
  },
];
---

<div class="grid gap-x-6 gap-y-8 md:grid-cols-2">
  {
    PROYECTS.map((proyecto) => (
      <div class="flex flex-col bg-white border border-gray-200 rounded-lg shadow-sm dark:bg-gray-800 hover:scale-102 transition-all dark:border-gray-700">
        <img
          class="rounded-t-lg aspect-[16/10] w-full object-cover object-top"
          src={proyecto.image}
          alt={proyecto.title}
          loading="lazy"
          decoding="async"
          width="1280"
          height="800"
        />

        <div class="flex flex-col grow p-5">
          <h5 class="mb-2 text-xl font-bold tracking-tight text-gray-900 dark:text-white">
            {proyecto.title}
          </h5>

          <p class="mb-4 font-normal text-sm text-gray-700 dark:text-gray-400">
            {proyecto.description}
          </p>

          <a
            href={proyecto.link}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Ver el proyecto ${proyecto.title}`}
            class="mt-auto inline-flex w-fit items-center px-3 py-2 text-sm font-medium text-center text-white bg-blue-700 rounded-lg hover:bg-blue-800 focus:ring-4 focus:outline-none focus:ring-blue-300 dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800"
          >
            Ver Proyecto
            <svg
              class="rtl:rotate-180 w-3.5 h-3.5 ms-2"
              aria-hidden="true"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 14 10"
            >
              <path
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M1 5h12m0 0L9 1m4 4L9 9"
              />
            </svg>
          </a>
        </div>
      </div>
    ))
  }
</div>
